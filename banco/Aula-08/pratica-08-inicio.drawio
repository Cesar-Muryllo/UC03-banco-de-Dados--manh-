ue="(1,1)" style="text;html=1;align=center;fontStyle=1;fontColor=#c62828;fontSize=14;" vertex="1" parent="1"><mxGeometry x="187" y="128" width="56" height="24" as="geometry"/></mxCell><mxCell id="c1" value="(0,n)" style="text;html=1;align=center;fontStyle=1;fontColor=#1b7f3b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="377" y="128" width="56" height="24" as="geometry"/></mxCell><mxCell id="n0" value="Degrau 2: ligue Pedido e Produto aqui." style="text;html=1;align=left;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="600" y="250" width="250" height="40" as="geometry"/></mxCell><mxCell id="q0" value="&lt;b&gt;Cliente faz Pedido&lt;/b&gt;&lt;br&gt;&lt;b&gt;Cliente → Pedido&lt;/b&gt; &lt;font color='#1b7f3b'&gt;&lt;b&gt;(0,n)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Um cliente faz zero ou muitos pedidos. O par fica perto de Pedido.&lt;br&gt;&lt;b&gt;Pedido → Cliente&lt;/b&gt; &lt;font color='#c62828'&gt;&lt;b&gt;(1,1)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cada pedido é de um e somente um cliente. O par fica perto de Cliente." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f9ff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20.0" y="300" width="360.0" height="118" as="geometry"/></mxCell><mxCell id="q1" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;font color='#1b7f3b'&gt;&lt;b&gt;(0,n) (1,n)&lt;/b&gt;&lt;/font&gt; máximo: muitos&lt;br&gt;&lt;font color='#c62828'&gt;&lt;b&gt;(0,1) (1,1)&lt;/b&gt;&lt;/font&gt; máximo: um&lt;br&gt;Leia saindo de uma entidade: o par fica perto da entidade de chegada." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f5f9ff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395.0" y="300" width="360.0" height="118" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>